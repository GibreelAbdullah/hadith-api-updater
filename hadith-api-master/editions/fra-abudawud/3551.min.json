{"metadata":{"name":"Sunan Abu Dawud","section":{"24":{"eng-name":"Wages (Kitab Al-Ijarah)","ara-name":"كتاب الإجارة"}},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570}}},"hadiths":[{"hadithnumber":3551,"arabicnumber":3551,"text":"Rapporté par Jabir ibn Abdullah رضي الله عنه : Le Prophète ﷺ a dit : « Si quelqu’un reçoit un usufruit viager, cela lui appartient ainsi qu’à ses descendants. Ses descendants qui héritent de lui hériteront aussi de ce bien. »","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":136},"chapter":{"id":51,"ara-name":"باب فِي الْعُمْرَى","eng-name":"Life-Long Gift","isFirstHadith":false}}]}