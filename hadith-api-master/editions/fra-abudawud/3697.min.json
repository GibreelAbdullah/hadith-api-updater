{"metadata":{"name":"Sunan Abu Dawud","section":{"27":{"eng-name":"Drinks (Kitab Al-Ashribah)","ara-name":"كتاب الأشربة"}},"section_detail":{"27":{"hadithnumber_first":3669,"hadithnumber_last":3735,"arabicnumber_first":3669,"arabicnumber_last":3735}}},"hadiths":[{"hadithnumber":3697,"arabicnumber":3697,"text":"Rapporté par Ali ibn Abu Talib رضي الله عنه : Le Messager d’Allah ﷺ nous a interdit d’utiliser les citrouilles, les jarres vertes, les troncs évidés et le vin fabriqué à partir d’orge","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":27,"hadith":29},"chapter":{"id":7,"ara-name":"باب فِي الأَوْعِيَةِ","eng-name":"Regarding vessels","isFirstHadith":false}}]}