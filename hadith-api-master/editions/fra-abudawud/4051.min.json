{"metadata":{"name":"Sunan Abu Dawud","section":{"34":{"eng-name":"Clothing (Kitab Al-Libas)","ara-name":"كتاب اللباس"}},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158}}},"hadiths":[{"hadithnumber":4051,"arabicnumber":4051,"text":"Rapporté par Ali ibn Abu Talib رضي الله عنه : Le Messager d’Allah ﷺ m’a interdit de porter une bague en or, un vêtement en qassi ou d’utiliser des tapis de selle violets","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":34,"hadith":32},"chapter":{"id":10,"ara-name":"باب مَنْ كَرِهَهُ","eng-name":"Whoever Regarded Silk As Disliked","isFirstHadith":false}}]}