{"metadata":{"name":"Sunan Abu Dawud","section":{"2":{"eng-name":"Prayer (Kitab Al-Salat)","ara-name":"كتاب الصلاة"}},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160}}},"hadiths":[{"hadithnumber":899,"arabicnumber":899,"text":"Rapporté par Abdullah ibn Abbas رضي الله عنه : Je suis venu derrière le Prophète ﷺ. J’ai vu la blancheur de ses aisselles et il tenait ses bras écartés de ses côtés et soulevait son ventre (du sol)","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":509},"chapter":{"id":160,"ara-name":"باب صِفَةِ السُّجُودِ","eng-name":"The Manner Of Prostration","isFirstHadith":false}}]}