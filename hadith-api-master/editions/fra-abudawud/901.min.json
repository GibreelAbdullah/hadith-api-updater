{"metadata":{"name":"Sunan Abu Dawud","section":{"2":{"eng-name":"Prayer (Kitab Al-Salat)","ara-name":"كتاب الصلاة"}},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160}}},"hadiths":[{"hadithnumber":901,"arabicnumber":901,"text":"Rapporté par Abu Huraira رضي الله عنه : Le Prophète ﷺ a dit : Lorsque l’un de vous se prosterne, il ne doit pas étendre ses avant-bras (au sol) comme le fait un chien, et il doit joindre ses deux cuisses","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":2,"hadith":511},"chapter":{"id":160,"ara-name":"باب صِفَةِ السُّجُودِ","eng-name":"The Manner Of Prostration","isFirstHadith":false}}]}