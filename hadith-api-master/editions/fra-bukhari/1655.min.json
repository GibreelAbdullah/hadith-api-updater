{"metadata":{"name":"Sahih al Bukhari","section":{"25":{"eng-name":"Hajj (Pilgrimage)","ara-name":"كتاب الحج"}},"section_detail":{"25":{"hadithnumber_first":1513,"hadithnumber_last":1772,"arabicnumber_first":1513,"arabicnumber_last":1772}}},"hadiths":[{"hadithnumber":1655,"arabicnumber":1655,"text":"Rapporté par `Abdullah bin `Umar : Le Messager d’Allah (ﷺ) a accompli une prière de deux unités à Mina. Abou Bakr, `Umar et `Uthman (au début de son califat) ont suivi cette pratique","grades":[{"name":"Imam Bukhari","grade":"Sahih"}],"reference":{"book":25,"hadith":136},"chapter":{"id":84,"ara-name":"باب الصَّلاَةِ بِمِنًى","eng-name":"As-Salat at Mina","isFirstHadith":true}}]}