{"metadata":{"name":"Sahih al Bukhari","section":{"25":{"eng-name":"Hajj (Pilgrimage)","ara-name":"كتاب الحج"}},"section_detail":{"25":{"hadithnumber_first":1513,"hadithnumber_last":1772,"arabicnumber_first":1513,"arabicnumber_last":1772}}},"hadiths":[{"hadithnumber":1766,"arabicnumber":1766,"text":"Rapporté par Ibn ‘Abbas : Séjourner à Al-Mahassab ne fait pas partie des rites du Hajj, mais Al-Mahassab est un endroit où le Messager d’Allah (ﷺ) a campé lors de son Hajj d’adieu","grades":[{"name":"Imam Bukhari","grade":"Sahih"}],"reference":{"book":25,"hadith":242},"chapter":{"id":147,"ara-name":"باب الْمُحَصَّبِ","eng-name":"Al-Muhassab","isFirstHadith":false}}]}