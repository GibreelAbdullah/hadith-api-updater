{"metadata":{"name":"Sunan Ibn Majah","section":{"33":{"eng-name":"Etiquette","ara-name":"كتاب الأدب"}},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826}}},"hadiths":[{"hadithnumber":3730,"arabicnumber":3730,"text":"Rapporté par Samurah : Le Messager d’Allah (ﷺ) a interdit de donner à nos esclaves quatre noms : Aflah (réussi), Nafi’ (utile), Rabah (profit) et Yasar (prospérité)","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":33,"hadith":74},"chapter":{"id":31,"ara-name":"باب مَا يُكْرَهُ مِنَ الأَسْمَاءِ","eng-name":"Names that are disliked","isFirstHadith":false}}]}