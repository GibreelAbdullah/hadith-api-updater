{"metadata":{"name":"Sunan Ibn Majah","section":{"1":{"eng-name":"The Book of Purification and its Sunnah","ara-name":"كتاب الطهارة وسننها"}},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666}}},"hadiths":[{"hadithnumber":503,"arabicnumber":503,"text":"Rapporté par ‘Aishah : Le Messager d’Allah faisait ses ablutions, puis il embrassait, puis il priait sans refaire ses ablutions. Parfois, il faisait cela avec moi","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":237},"chapter":{"id":69,"ara-name":"باب الْوُضُوءِ مِنَ الْقُبْلَةِ","eng-name":"Ablution due to kissing","isFirstHadith":false}}]}