{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":10,"arabicnumber":10,"text":"Rapporté par Abu Hurairah : Le Messager d’Allah (ﷺ) a dit : \"La fitrah comporte cinq choses : tailler la moustache, épiler les aisselles, couper les ongles, épiler le pubis et la circoncision","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":1,"hadith":10},"chapter":{"id":10,"ara-name":"باب تَقْلِيمِ الأَظْفَارِ ","eng-name":"Clipping The Nails","isFirstHadith":true}}]}