{"metadata":{"name":"Sunan an Nasai","section":{"24":{"eng-name":"The Book of Hajj","ara-name":"كتاب مناسك الحج"}},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084}}},"hadiths":[{"hadithnumber":2701,"arabicnumber":2701,"text":"Rapporté par 'Aishah : Je mettais du parfum sur le Messager d'Allah ﷺ avec le meilleur parfum que je pouvais trouver, jusqu'à ce que je voie le parfum briller sur sa tête et dans sa barbe, avant qu'il n'entre en état d'Ihram","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":83},"chapter":{"id":42,"ara-name":"باب مَوْضِعِ الطِّيبِ .","eng-name":"Where the Perfume is applied","isFirstHadith":false}}]}