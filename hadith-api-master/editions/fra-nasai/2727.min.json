{"metadata":{"name":"Sunan an Nasai","section":{"24":{"eng-name":"The Book of Hajj","ara-name":"كتاب مناسك الحج"}},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084}}},"hadiths":[{"hadithnumber":2727,"arabicnumber":2727,"text":"Rapporté par 'Imran : Le Messager d'Allah a combiné le Hajj et la 'Umrah, puis aucun verset du Coran n'a été révélé à ce sujet, et le Prophète ne l'a pas interdit, peu importe ce que quelqu'un pourrait dire","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":109},"chapter":{"id":49,"ara-name":"باب الْقِرَانِ .","eng-name":"Qiran","isFirstHadith":false}}]}