{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":276,"arabicnumber":276,"text":"Rapporté par 'Aishah : Le Prophète (ﷺ) sortait sa tête pour moi pendant qu’il faisait la retraite spirituelle et je la lavais, alors que j’avais mes règles","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":277},"chapter":{"id":176,"ara-name":"باب غَسْلِ الْحَائِضِ رَأْسَ زَوْجِهَا","eng-name":"A Menstruating Woman Washing Her Husband's Head","isFirstHadith":false}}]}