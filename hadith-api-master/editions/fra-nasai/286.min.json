{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":286,"arabicnumber":286,"text":"Rapporté par 'Aishah : Si l'une d'entre nous avait ses règles, le Messager d'Allah (ﷺ) lui demandait de mettre un izar (voile autour de la taille), puis il la caressait","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"}],"reference":{"book":1,"hadith":287},"chapter":{"id":180,"ara-name":"باب مُبَاشَرَةِ الْحَائِضِ","eng-name":"Fondling A Menstruating Woman","isFirstHadith":false}}]}