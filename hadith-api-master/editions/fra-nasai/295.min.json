{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":295,"arabicnumber":295,"text":"Rapporté par 'Aishah : Je lavais les traces de janabah sur le vêtement du Messager d'Allah (ﷺ) et il sortait prier alors que des traces d'eau étaient encore visibles sur son vêtement","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":296},"chapter":{"id":187,"ara-name":"باب غَسْلِ الْمَنِيِّ مِنَ الثَّوْبِ","eng-name":"Washing Semen From A Garment","isFirstHadith":true}}]}