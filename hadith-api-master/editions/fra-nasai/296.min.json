{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":296,"arabicnumber":296,"text":"Rapporté par 'Aishah : Je grattais la janabah. Une autre fois, elle a dit : \"Le sperme sur le vêtement du Messager d'Allah (ﷺ)","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":297},"chapter":{"id":188,"ara-name":"باب فَرْكِ الْمَنِيِّ مِنَ الثَّوْبِ","eng-name":"Rubbing Semen From A Garment","isFirstHadith":true}}]}