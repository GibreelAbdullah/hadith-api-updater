{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":45,"arabicnumber":45,"text":"Rapporté par Anas bin Malik : \"Quand le Messager d’Allah ﷺ allait aux toilettes, moi et un autre garçon comme moi lui apportions un petit récipient en cuir rempli d’eau, et il se nettoyait avec l’eau","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":45},"chapter":{"id":41,"ara-name":"باب الاِسْتِنْجَاءِ بِالْمَاءِ ","eng-name":"Cleaning Oneself With Water","isFirstHadith":true}}]}