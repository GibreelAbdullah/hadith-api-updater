{"metadata":{"name":"Sunan an Nasai","section":{"1":{"eng-name":"The Book of Purification","ara-name":"كتاب الطهارة"}},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324}}},"hadiths":[{"hadithnumber":46,"arabicnumber":46,"text":"Rapporté par ‘Aishah : \"Dites à vos maris de se nettoyer avec de l’eau, car je suis trop gênée pour leur dire moi-même. Le Messager d’Allah ﷺ le faisait","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":46},"chapter":{"id":41,"ara-name":"باب الاِسْتِنْجَاءِ بِالْمَاءِ ","eng-name":"Cleaning Oneself With Water","isFirstHadith":false}}]}