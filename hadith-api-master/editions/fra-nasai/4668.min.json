{"metadata":{"name":"Sunan an Nasai","section":{"44":{"eng-name":"The Book of Financial Transactions","ara-name":"كتاب البيوع"}},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705}}},"hadiths":[{"hadithnumber":4668,"arabicnumber":4668,"text":"Rapporté par Jabir bin 'Abdullah : Le Messager d’Allah ﷺ a interdit le prix des chiens et des chats, sauf pour les chiens de chasse. (Da'if) Abu 'Abdur-Rahman (An-Nasa'i) a dit : Ceci est Munkar","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":44,"hadith":220},"chapter":{"id":92,"ara-name":"باب مَا اسْتُثْنِيَ ","eng-name":"Exceptions from that","isFirstHadith":true}}]}