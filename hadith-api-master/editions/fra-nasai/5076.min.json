{"metadata":{"name":"Sunan an Nasai","section":{"48":{"eng-name":"The Book of Adornment","ara-name":"كتاب الزينة من السنن"}},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378}}},"hadiths":[{"hadithnumber":5076,"arabicnumber":5076,"text":"Rapporté par Jabir : \"Abu Quhafah a été amené le jour de la conquête de La Mecque, et ses cheveux et sa barbe étaient blancs comme la plante Thaghamah. Le Messager d’Allah ﷺ a dit : 'Changez cela avec autre chose, mais évitez le noir","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":48,"hadith":37},"chapter":{"id":15,"ara-name":"باب النَّهْىِ عَنِ الْخِضَابِ، بِالسَّوَادِ ","eng-name":"Prohibition of Dyeing Hair Black","isFirstHadith":false}}]}